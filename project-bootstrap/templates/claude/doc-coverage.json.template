{
  "_instructions": "ADAPT: Replace [PLACEHOLDER] values with your project's actual paths. Remove sections that don't apply. Exemption is by is_doc() in doc-check.py (anything under docs/, CLAUDE.md, .claude/rules/, memory/), NOT by a list here — there is no 'exempt' key. Triggers below are matched by str.startswith on the repo-relative path.",

  "planning_triggers": [
    "[TRACKED_DIR_1]",
    "[TRACKED_DIR_2]",
    "docs/changes/",
    "scripts/"
  ],

  "changelog_rotation": {
    "max_lines": 500,
    "archive_path": "docs/_archive/changelog/",
    "archive_format": "YYYY-MM.md",
    "policy": "by_size_oldest_first"
  },

  "blocking_triggers": [
    {
      "_comment": "Database migrations ALWAYS require schema doc update",
      "pattern": "[MIGRATIONS_DIR]",
      "docs": ["docs/db.md"]
    },
    {
      "_comment": "Infrastructure changes ALWAYS require doc update",
      "pattern": "[DEPLOY_DIR]",
      "docs": ["docs/infrastructure.md"]
    },
    {
      "pattern": "docker-compose",
      "docs": ["docs/infrastructure.md"]
    },
    {
      "pattern": "Dockerfile",
      "docs": ["docs/infrastructure.md"]
    }
  ],

  "warning_triggers": [
    {
      "_comment": "Source areas: warn but don't block. Agent decides if change is architectural.",
      "pattern": "[SOURCE_DIR_1]",
      "docs": ["docs/[AREA_1].md"]
    },
    {
      "pattern": "[SOURCE_DIR_2]",
      "docs": ["docs/[AREA_2].md"]
    }
  ]
}
